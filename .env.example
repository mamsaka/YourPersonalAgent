# Скопируй в .env и заполни. Файл .env нельзя публиковать и добавлять в git.
OPENROUTER_API_KEY=

# --- Ниже приложение дописывает и обновляет эти ключи автоматически ---
# OPENROUTER_MODEL=...          последняя выбранная модель
# AGENT_LAST_SESSION=...        id последнего активного чата
# AGENT_THEME=...               тема интерфейса: dark или light
# AGENT_CONFIRM_DANGEROUS=...   подтверждение опасных действий: true или false
# AGENT_WINDOW_GEOMETRY=...     размер и позиция окна, например 1240x800+100+50

# --- Дополнительные параметры (обычно менять не нужно) ---
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MAX_TOOL_ROUNDS=40      # 0 = без лимита шагов (не рекомендуется)
# OPENROUTER_MAX_TOKENS=8192
# OPENROUTER_MAX_HISTORY=24
# OPENROUTER_TIMEOUT=90
# OPENROUTER_STREAM=true             # потоковый вывод ответа по мере генерации
# OPENROUTER_VERIFY_SSL=true
